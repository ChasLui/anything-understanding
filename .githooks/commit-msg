#!/usr/bin/env bash
# Validate the first line of the commit message (Conventional Commits).
# Enabled by `git config core.hooksPath .githooks` (see scripts/setup-dev.sh).
# Merge and fixup!/squash! messages are allowed through for rebase workflows.
set -uo pipefail

msg_file=${1:-}
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  echo "commit-msg: no message file" >&2
  exit 1
fi

subject=$(sed -n '1p' "$msg_file")
case $subject in
  Merge\ * | 'fixup! '* | 'squash! '*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([A-Za-z0-9._/-]+\))?!?: .+'
if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  cat >&2 <<'EOF'
commit-msg: subject must be a Conventional Commit, e.g.
  feat(2d-understanding): cross-check EXIF orientation
  fix(repo): keep verify.sh working on bash 3.2
  docs: explain the macOS-only OCR dependency
See CONTRIBUTING.md#commits.
EOF
  exit 1
fi
